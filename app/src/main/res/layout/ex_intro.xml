<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_tag"
            android:fontFamily="sans-serif-black"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="✨ NEW SIGN"
            android:textColor="@color/primary"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/cardSign"
            android:layout_width="match_parent"
            android:layout_height="290dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/opt_default"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp">

            <LinearLayout
                android:id="@+id/frontSide"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <com.example.signlearn.HandSignView
                    android:id="@+id/handView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvLabel"
                    style="@style/Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A"
                    android:textSize="34sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/backSide"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡"
                    android:textSize="48sp" />

                <TextView
                    style="@style/Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="MEMORY TIP" />

                <TextView
                    android:id="@+id/tvTip"
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textSize="21sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvHow"
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textSize="17sp" />

        <TextView
            style="@style/Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="👆 Tap the card to flip it"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnTryCamera"
            style="@style/ChunkyButton.Small.White"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:text="📷  Try it with the camera"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
