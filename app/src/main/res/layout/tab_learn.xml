<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollLearn"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Greeting + daily goal + level -->
        <LinearLayout
            android:id="@+id/cardGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGreeting"
                    style="@style/Heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hi!"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag"
                    android:fontFamily="sans-serif-black"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="LV 1"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGoalLabel"
                style="@style/Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🎯 Daily goal: 0 / 30 XP" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                app:indicatorColor="@color/green"
                app:trackColor="@color/border"
                app:trackCornerRadius="6dp"
                app:trackThickness="12dp" />

            <TextView
                android:id="@+id/tvLevelLabel"
                style="@style/Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="⭐ Level 1 · 0 / 50 XP" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                app:indicatorColor="@color/yellow"
                app:trackColor="@color/border"
                app:trackCornerRadius="6dp"
                app:trackThickness="12dp" />
        </LinearLayout>

        <!-- The lesson path is built in code (MainActivity.buildPath) -->
        <LinearLayout
            android:id="@+id/pathContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:orientation="vertical" />

        <TextView
            style="@style/Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="🚧 More units coming soon!" />
    </LinearLayout>
</ScrollView>
